{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisResult",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "requirement.schema.json" } },
    "assumptions": { "type": "array", "items": { "type": "object", "required": ["id", "text", "status"],
      "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "status": { "enum": ["proposed", "confirmed", "needs-review"] } } } },
    "openQuestions": { "type": "array", "items": { "type": "object", "required": ["id", "text"],
      "properties": { "id": { "type": "string" }, "text": { "type": "string" } } } },
    "aiUseCases": { "type": "array", "items": { "type": "object", "required": ["id", "title", "reqs"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "reqs": { "type": "array", "items": { "type": "string" } } } } }
  }
}
