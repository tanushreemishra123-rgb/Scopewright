{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirement",
  "type": "object",
  "required": ["id", "type", "priority", "classification", "description", "sourceText", "dependencies"],
  "properties": {
    "id": { "type": "string", "pattern": "^(BR|FR|NFR|INT|DATA|SEC)_\\d{2}$" },
    "type": { "enum": ["Business", "Functional", "Non-functional", "Integration", "Data", "Security"] },
    "priority": { "enum": ["High", "Medium", "Low"] },
    "classification": { "enum": ["customer-stated", "ai-inferred", "assumed"] },
    "module": { "type": "string" },
    "description": { "type": "string", "minLength": 3 },
    "sourceText": { "type": "string", "minLength": 1, "description": "Originating customer text — required for traceability" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "openQuestion": { "type": "string" },
    "included": { "type": "boolean" }
  }
}
